#!/usr/bin/env python3
"""clibmolk: fetch single-header modules (and their dependencies) from
GitHub releases.

    clibmolk download array.h v0.1.0            # also fetches err.h, attr.h
    clibmolk download str v0.1.0 --dest vendor  # ".h" is optional
    clibmolk download err.h latest --no-deps
    clibmolk list v0.1.0                        # modules in a release

Each release carries every header plus `deps.json` as assets. Dependencies
are resolved from the deps.json of the *same* release, so a set of files
always comes from one version. Headers are written flat into --dest (default
`.`), which is what their `#include "err.h"`-style includes expect.
"""
import argparse, json, os, sys, urllib.error, urllib.request

DEFAULT_REPO = "molkars/clibmolk"


def base_url(repo, tag, override):
    if override:  # e.g. file:///path/to/clibmolk-dist/, for testing
        return override.rstrip("/") + "/"
    if tag == "latest":
        return f"https://github.com/{repo}/releases/latest/download/"
    return f"https://github.com/{repo}/releases/download/{tag}/"


def fetch(url):
    try:
        with urllib.request.urlopen(url, timeout=30) as r:
            return r.read()
    except urllib.error.HTTPError as e:
        raise SystemExit(f"clibmolk: {url}: HTTP {e.code} {e.reason}")
    except (urllib.error.URLError, OSError) as e:
        raise SystemExit(f"clibmolk: {url}: {e}")


def module_name(arg):
    return arg[:-2] if arg.endswith(".h") else arg


def closure(deps, names):
    out, todo = [], list(names)
    while todo:
        n = todo.pop(0)
        if n not in deps:
            raise SystemExit(
                f"clibmolk: unknown module '{n}' (have: {', '.join(sorted(deps))})")
        if n not in out:
            out.append(n)
            todo += deps[n]
    return out


def cmd_download(a):
    base = base_url(a.repo, a.tag, a.base_url)
    deps = json.loads(fetch(base + "deps.json"))
    want = [module_name(m) for m in a.modules]
    mods = want if a.no_deps else closure(deps, want)
    for m in want:
        closure(deps, [m])  # validates the name even with --no-deps
    os.makedirs(a.dest, exist_ok=True)
    for m in mods:
        path = os.path.join(a.dest, m + ".h")
        data = fetch(base + m + ".h")
        if os.path.exists(path) and not a.force:
            if open(path, "rb").read() == data:
                print(f"same     {path}")
                continue
            print(f"exists   {path} (differs; use --force to overwrite)")
            continue
        with open(path, "wb") as f:
            f.write(data)
        tag = "" if m in want else "  (dependency)"
        print(f"wrote    {path}{tag}")
    return 0


def cmd_list(a):
    deps = json.loads(fetch(base_url(a.repo, a.tag, a.base_url) + "deps.json"))
    for m in sorted(deps):
        d = ", ".join(deps[m]) or "-"
        print(f"{m + '.h':10} deps: {d}")
    return 0


def main():
    p = argparse.ArgumentParser(prog="clibmolk", description=__doc__.split("\n\n")[0])
    p.add_argument("--repo", default=DEFAULT_REPO, help=f"owner/name (default {DEFAULT_REPO})")
    p.add_argument("--base-url", default=os.environ.get("CLIBMOLK_BASE_URL"),
                   help="fetch assets from this URL prefix instead of GitHub "
                        "(env CLIBMOLK_BASE_URL), e.g. file:///path/to/clibmolk/dist")
    sub = p.add_subparsers(dest="cmd", required=True)

    d = sub.add_parser("download", help="download headers and their dependencies")
    d.add_argument("modules", nargs="+", metavar="HEADER")
    d.add_argument("tag", help="release tag, e.g. v0.1.0, or 'latest'")
    d.add_argument("--dest", default=".", help="directory to write into (default .)")
    d.add_argument("--no-deps", action="store_true", help="only the named headers")
    d.add_argument("--force", action="store_true", help="overwrite files that differ")
    d.set_defaults(fn=cmd_download)

    l = sub.add_parser("list", help="list the modules in a release")
    l.add_argument("tag", nargs="?", default="latest")
    l.set_defaults(fn=cmd_list)

    a = p.parse_args()
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
